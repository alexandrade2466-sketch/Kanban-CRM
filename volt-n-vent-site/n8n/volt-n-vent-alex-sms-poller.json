{
  "name": "Volt N Vent - Alex SMS Poller (no GHL workflow)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "seconds", "secondsInterval": 45 }]
        }
      },
      "id": "b2000001-0001-4000-8000-000000000001",
      "name": "Every 30 Seconds",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://services.leadconnectorhq.com/conversations/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "locationId", "value": "81uoqXcdjO6CKRFIIuw6" },
            { "name": "limit", "value": "30" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Version", "value": "2021-07-28" }]
        },
        "options": {}
      },
      "id": "b2000001-0001-4000-8000-000000000002",
      "name": "GHL Recent Conversations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_GHL_CREDENTIAL_ID",
          "name": "GoHighLevel API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const convs = $input.first().json.conversations || [];\nconst now = Date.now();\nconst minAgeMs = 8 * 1000;\nconst maxAgeMs = 20 * 60 * 1000;\nconst out = [];\nfor (const c of convs) {\n  if (c.lastMessageDirection !== 'inbound') continue;\n  if (!c.lastMessageBody || !c.contactId) continue;\n  const age = now - Number(c.lastMessageDate || 0);\n  if (age < minAgeMs) continue;\n  if (age > maxAgeMs) continue;\n  const key = `${c.contactId}:${c.lastMessageDate}`;\n  out.push({ json: { client_slug: 'volt-n-vent', contact_id: c.contactId, message_body: String(c.lastMessageBody).trim(), conversation_id: c.id, location_id: c.locationId || '81uoqXcdjO6CKRFIIuw6', dedupe_key: key, message_type: 'SMS' } });\n}\nreturn out;"
      },
      "id": "b2000001-0001-4000-8000-000000000003",
      "name": "Find New Inbound SMS",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://voltnvent.com/api/ghl-sms-webhook",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": { "response": { "response": { "neverError": true } } }
      },
      "id": "b2000001-0001-4000-8000-000000000004",
      "name": "Send to Alex Bot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300]
    }
  ],
  "connections": {
    "Every 30 Seconds": { "main": [[{ "node": "GHL Recent Conversations", "type": "main", "index": 0 }]] },
    "GHL Recent Conversations": { "main": [[{ "node": "Find New Inbound SMS", "type": "main", "index": 0 }]] },
    "Find New Inbound SMS": { "main": [[{ "node": "Send to Alex Bot", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "active": false
}
